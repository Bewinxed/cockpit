{
  "name": "@agentdeck/agent",
  "version": "0.0.1",
  "description": "AgentDeck Agent - Connect your machine to AgentDeck for remote Claude instance management",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "agentdeck-agent": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:bundle && bun run build:types",
    "build:bundle": "bun build src/cli.ts src/index.ts --outdir dist --target bun --external @anthropic-ai/claude-agent-sdk --external bonjour-service --external ws",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "agentdeck",
    "claude",
    "ai",
    "agent",
    "anthropic",
    "remote",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/agentdeck"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@agentdeck/auth": "workspace:*",
    "@agentdeck/core": "workspace:*",
    "@agentdeck/db": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.3"
  }
}
