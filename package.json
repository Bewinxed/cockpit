{
  "name": "agentdeck",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "bun run dev:dashboard",
    "dev:dashboard": "bun run --filter @agentdeck/dashboard dev",
    "dev:agent": "bun run --filter @agentdeck/agent-service dev",
    "dev:all": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "build:cli": "bun run --filter @agentdeck/cli build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun build packages/agent-service/src/index.ts packages/hub-server/src/index.ts --target=bun --outdir /tmp/agentdeck-check",
    "hub": "bun cli/src/index.ts hub",
    "agent": "bun cli/src/index.ts agent",
    "agent:local": "bun cli/src/index.ts agent --hub ws://localhost:3456/ws/hub",
    "status": "bun cli/src/index.ts status",
    "login": "bun cli/src/index.ts login",
    "logout": "bun cli/src/index.ts logout",
    "cli": "bun cli/src/index.ts",
    "db:push": "bun run --filter @agentdeck/db db:push"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest",
    "elysia": "^1.4.22",
    "@types/bun": "latest"
  },
  "dependencies": {
    "elysia": "^1.4.22",
    "river.ts": "^1.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@lucide/svelte": "^0.562.0",
    "@types/bun": "latest",
    "@types/node": "^22.19.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  }
}
