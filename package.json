{
  "name": "cockpit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "bun run dev:dashboard",
    "dev:dashboard": "bun run --filter @cockpit/dashboard dev",
    "dev:agent": "bun run --filter @cockpit/agent-service dev",
    "dev:all": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "build:cli": "bun run --filter @cockpit/cli build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun build packages/agent-service/src/index.ts packages/hub-server/src/index.ts --target=bun --outdir /tmp/cockpit-check",
    "hub": "bun cli/src/index.ts hub",
    "agent": "bun cli/src/index.ts agent",
    "agent:local": "bun cli/src/index.ts agent --hub ws://localhost:3456/ws/hub",
    "status": "bun cli/src/index.ts status",
    "login": "bun cli/src/index.ts login",
    "logout": "bun cli/src/index.ts logout",
    "cli": "bun cli/src/index.ts",
    "db:push": "bun run --filter @cockpit/db db:push"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest",
    "elysia": "^1.4.22",
    "@types/bun": "latest"
  },
  "dependencies": {
    "elysia": "^1.4.22"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.562.0",
    "@types/bun": "latest",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
