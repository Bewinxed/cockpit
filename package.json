{
  "name": "cockpit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:dashboard",
    "dev:dashboard": "bun run --filter '@cockpit/dashboard' dev",
    "dev:hub": "bun run --filter '@cockpit/hub' dev",
    "dev:agent": "bun run --filter '@cockpit/agent' dev",
    "dev:all": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "hub": "bun run --filter '@cockpit/hub' dev",
    "agent": "bun run --filter '@cockpit/agent' start",
    "cockpit": "bun packages/cli/src/cli.ts",
    "db:push": "bun run --filter '@cockpit/hub' db:push",
    "smoke:insecure": "node scripts/insecure-origin-smoke.mjs",
    "lint:changed": "git diff --name-only --diff-filter=ACMR HEAD -- 'apps/dashboard/src/**/*.ts' 'apps/dashboard/src/**/*.svelte' | xargs -r eslint"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest",
    "@types/bun": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "patchedDependencies": {
    "svelte-streamdown@3.1.2": "patches/svelte-streamdown@3.1.2.patch",
    "virtua@0.50.0": "patches/virtua@0.50.0.patch"
  },
  "dependencies": {
    "torph": "^0.1.0"
  }
}
